GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
REVORA_API_KEY=
# Optional: configure both URLs to gate real HTTP services reachable from backend.
REVORA_SERVICE_NAME=revora-demo
REVORA_STABLE_URL=
REVORA_CANDIDATE_URL=

# Local API safety and resource bounds
APP_ENV=development
ALLOW_ANONYMOUS=false
ALLOW_MEMORY_FALLBACK=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
# Agent tool state is process-scoped; keep capacity at exactly one.
GROQ_MAX_CONCURRENT_RUNS=1
GROQ_TOTAL_TIMEOUT_SECONDS=120
# Trust only the exact reverse-proxy addresses for your hosting provider.
FORWARDED_ALLOW_IPS=127.0.0.1
