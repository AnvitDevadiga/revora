# Copy into the backend environment for local development. Never commit credentials.
APP_ENV=development
ALLOW_ANONYMOUS=false
ALLOW_MEMORY_FALLBACK=true
FALKORDB_URL=falkor://localhost:6379
FALKORDB_GRAPH=revora
REVORA_API_KEY=
REVORA_SERVICE_NAME=revora-demo
REVORA_STABLE_URL=
REVORA_CANDIDATE_URL=
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FORWARDED_ALLOW_IPS=127.0.0.1
PORT=8000
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_CONCURRENT_RUNS=1
GROQ_TOTAL_TIMEOUT_SECONDS=120
